# NestJS API
PORT=3000
CORS_ORIGIN=http://localhost:5173
DATABASE_POOL_SIZE=5

# Neon Postgres (neon env pull manages the connection values)
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_BRANCH=main
NEON_BRANCH_ID=

# Neon Managed Better Auth (populated by neon deploy)
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=

# Neon Object Storage (populated by neon deploy)
NEON_STORAGE_BUCKET=uploads
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-2

# Present when Neon Functions are enabled; unused by this NestJS API
NEON_FUNCTION_HOST_SUFFIX=

# Zoho ZeptoMail (required for contact email sending)
ZOHO_MAIL_API_URL=https://cpaas.zoho.com/v1.1/email
# Use the bare send-mail key or the copied value prefixed with Zoho-enczapikey.
ZOHO_MAIL_API_TOKEN=
ZOHO_MAIL_FROM=
ZOHO_MAIL_FROM_NAME=Cephas CRM
MAIL_SEND_TIMEOUT_MS=15000

# Zoho Campaigns (OAuth required for marketing email campaigns)
ZOHO_CAMPAIGNS_API_URL=https://campaigns.zoho.com/api/v1.1
ZOHO_CAMPAIGNS_ACCOUNTS_URL=https://accounts.zoho.com
ZOHO_CAMPAIGNS_CLIENT_ID=
ZOHO_CAMPAIGNS_CLIENT_SECRET=
ZOHO_CAMPAIGNS_REFRESH_TOKEN=
ZOHO_CAMPAIGNS_FROM_EMAIL=
ZOHO_CAMPAIGNS_FROM_NAME=Cephas CRM
ZOHO_CAMPAIGNS_TOPIC_ID=
ZOHO_CAMPAIGNS_TIMEZONE=Africa/Lagos
API_PUBLIC_URL=

# Termii bulk SMS (use a sender ID approved in your Termii account)
TERMII_API_KEY=
TERMII_BASE_URL=https://api.ng.termii.com
TERMII_SENDER_ID=
TERMII_COUNTRY_CODE=234
TERMII_CHANNEL=generic

# Zoho CPaaS WhatsApp channel (use the WhatsApp API key for the sending Agent)
ZOHO_WHATSAPP_API_URL=https://cpaas.zoho.com/v1.1/whatsapp
ZOHO_WHATSAPP_API_KEY=
ZOHO_WHATSAPP_AGENT_ID=
ZOHO_WHATSAPP_FROM=
ZOHO_WHATSAPP_COUNTRY_CODE=234
